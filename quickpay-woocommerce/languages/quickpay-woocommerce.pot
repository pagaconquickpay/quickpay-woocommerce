#: includes/class-qp-gateway.php:83
#, php-format
msgid "En tu portal, Integraciones › Webhooks › Agregar URL, registra esta dirección con el evento link.pagado: %s — y pega aquí el secreto que te muestra (se muestra una sola vez)."
msgstr ""

#: includes/class-qp-gateway.php:89
msgid "Moneda de la tienda"
msgstr ""

#: includes/class-qp-gateway.php:91
msgid "QuickPay cobra sólo en bolívares. Si tu tienda vende en otra moneda, el total se multiplica por la tasa que escribas abajo. Este plugin no consulta ninguna tasa por su cuenta: la decides tú y la mantienes al día."
msgstr ""

#: includes/class-qp-gateway.php:94
msgid "Mi tienda ya vende en bolívares (VES)"
msgstr ""

